# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable here is parsed by Zod at module load — see src/lib/env.ts
# (public) and src/lib/env.server.ts (secrets).

# ---- Public: compiled into the client bundle, visible to anyone --------------

# Origin the app is served from. Used for OAuth redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon key — Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LiveKit Cloud websocket URL — LiveKit dashboard → Settings → Keys.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- Secret: server only. Never prefix any of these with NEXT_PUBLIC_ --------

# Supabase service-role key. Bypasses RLS — read only in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit API credentials. Sign access tokens and verify webhook signatures.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
